<Project Sdk="Microsoft.NET.Sdk">
  <!-- Sound output for MMUCS.Core.Media through OpenAL Soft. Kept apart so Core stays free of native libraries. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MMUCS.Media.OpenAL</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MMUCS.Core\MMUCS.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <!-- OpenAL Soft's native library for Windows, Linux and macOS, so nothing needs installing. -->
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
  </ItemGroup>
</Project>
