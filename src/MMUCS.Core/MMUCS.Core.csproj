<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MMUCS.Core</RootNamespace>
    <!-- Ported legacy code: keep the build readable while it is cleaned up incrementally. -->
    <NoWarn>$(NoWarn);CS1998;CS0168;CS0219;CS0414;CS0649;CS0169</NoWarn>
  </PropertyGroup>
</Project>
