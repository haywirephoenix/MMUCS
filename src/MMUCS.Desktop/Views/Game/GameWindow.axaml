<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MMUCS.Desktop.ViewModels"
        xmlns:c="using:MMUCS.Desktop.Controls"
        x:Class="MMUCS.Desktop.Views.Game.GameWindow"
        x:DataType="vm:GameViewModel"
        Title="Game"
        Icon="/Assets/mmucs.ico"
        Width="1100" Height="680" MinWidth="480" MinHeight="320">

  <Window.Styles>
    <Style Selector="Button.transport">
      <Setter Property="MinWidth" Value="64" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <!-- The viewers' shared preview panel (Controls/ViewerPreview.cs): its toolbar holds Play / Pause / Stop; the canvas keeps 16:9. -->
  <c:ViewerPreview Title="Game" Info="{Binding Status}" ShowZoom="False">
    <c:ViewerPreview.Tools>
      <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,8,0">
        <Button Classes="transport" Content="Play" Command="{Binding PlayCommand}"
                ToolTip.Tip="Start the game; then click the canvas to capture the mouse" />
        <Button Classes="transport" Content="Pause" Command="{Binding PauseCommand}"
                ToolTip.Tip="Pause the game where it is and let the mouse go; Play carries on" />
        <Button Classes="transport" Content="Stop" Command="{Binding StopCommand}"
                ToolTip.Tip="End the game, as its own Quit does: Play boots it afresh" />
        <ToggleButton Content="Scripts" IsChecked="{Binding RunScripts}" Margin="8,0,0,0"
                      ToolTip.Tip="On: the game runs its own scripts from boot (MMUCS.Runtime's interpreter). Off: the hand-written stand-ins (a hotspot, the verb coin and the inventory). Switching stops the game." />
        <ToggleButton Content="Smooth camera" IsChecked="{Binding SmoothCamera}" Margin="8,0,0,0"
                      ToolTip.Tip="On: the camera eases after its target, and walking actors glide with it while it moves. Off: the camera and actors step as SCUMM's do. The scripts see the same camera either way." />
        <ToggleButton Content="Smooth walk" IsChecked="{Binding SmoothWalk}" IsEnabled="{Binding SmoothCamera}" Margin="8,0,0,0"
                      ToolTip.Tip="On: walking actors glide between frames all the time. Off: they step as SCUMM's do, so their feet stay planted, and glide only while the camera moves. Needs Smooth camera. The scripts see the same positions either way." />
                <c:FontPicker Chooser="{Binding Fonts}" Margin="8,0,0,0" ToolTip.Tip="{Binding FontInfo}" />
      </StackPanel>
    </c:ViewerPreview.Tools>

    <c:GameCanvas x:Name="Canvas" Focusable="True" Frame="{Binding Frame}" />

    <c:ViewerPreview.Overlay>
      <Panel>
        <Border IsVisible="{Binding SystemMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" IsHitTestVisible="False"
                VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="520"
                Background="{DynamicResource OverlayBackgroundBrush}" CornerRadius="4">
          <TextBlock Text="{Binding SystemMessage}" Margin="16,10" FontSize="15" TextWrapping="Wrap" TextAlignment="Center" />
        </Border>
        <Border IsVisible="{Binding Toast, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" IsHitTestVisible="False"
                VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12"
                Background="{DynamicResource OverlayBackgroundBrush}" CornerRadius="3">
          <TextBlock Text="{Binding Toast}" Margin="10,5" FontSize="12" />
        </Border>
        <Border IsVisible="{Binding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" IsHitTestVisible="False"
                VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12"
                Background="{DynamicResource OverlayBackgroundBrush}" CornerRadius="3">
          <TextBlock Text="{Binding Hint}" Margin="10,5" FontSize="12" Foreground="{DynamicResource SubtleTextBrush}" />
        </Border>
      </Panel>
    </c:ViewerPreview.Overlay>
  </c:ViewerPreview>
</Window>
