<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMUCS.Desktop.ViewModels"
             xmlns:c="using:MMUCS.Desktop.Controls"
             x:Class="MMUCS.Desktop.Views.ObjectImageView"
             x:DataType="vm:ObjectImageViewModel">
  <!-- Like the Costume viewer: the preview in the middle, a list on the right (here the object's states). -->
  <Grid ColumnDefinitions="*,4,220">
    <Grid>
      <c:CelCanvas RawImage="{Binding PreviewImage}" Mode="Raw" AlphaEnabled="True" />
      <ScrollViewer VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8"
                    VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource OverlayBackgroundBrush}">
        <StackPanel Margin="8,4">
          <TextBlock Text="{Binding Title}" Classes="mono" FontSize="11" />
          <TextBlock Text="{Binding Info}" Classes="mono" FontSize="11" TextWrapping="Wrap"
                     Foreground="{DynamicResource SubtleTextBrush}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <GridSplitter Grid.Column="1" ResizeDirection="Columns" />
    <DockPanel Grid.Column="2">
      <TextBlock DockPanel.Dock="Top" Text="States" FontSize="11" Margin="8,6,8,2"
                 Foreground="{DynamicResource SubtleTextBrush}"
                 ToolTip.Tip="Pick a state to preview its image here and draw the object in that state in the Room viewer" />
      <ListBox ItemsSource="{Binding States}" SelectedItem="{Binding SelectedState, Mode=TwoWay}">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,3" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="vm:ObjectStateItem">
            <Grid ColumnDefinitions="64,8,*">
              <Border Width="64" Height="40" Background="{DynamicResource ThumbnailBackgroundBrush}">
                <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
              </Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label}" FontSize="12" />
                <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{DynamicResource SubtleTextBrush}" />
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
