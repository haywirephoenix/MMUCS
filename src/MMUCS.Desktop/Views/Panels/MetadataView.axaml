<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMUCS.Desktop.ViewModels"
             x:Class="MMUCS.Desktop.Views.Panels.MetadataView"
             x:DataType="vm:MainWindowViewModel">
  <ListBox ItemsSource="{Binding Metadata}">
    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="0" />
      </Style>
    </ListBox.Styles>
    <ListBox.ItemTemplate>
      <DataTemplate DataType="vm:MetadataRow">
        <Grid ColumnDefinitions="110,*">
          <TextBlock Text="{Binding Key}" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" />
          <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap" />
        </Grid>
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
