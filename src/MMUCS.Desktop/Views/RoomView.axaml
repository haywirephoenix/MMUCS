<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMUCS.Desktop.ViewModels"
             xmlns:c="using:MMUCS.Desktop.Controls"
             x:Class="MMUCS.Desktop.Views.RoomView"
             x:DataType="vm:RoomViewModel">
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="panel-header" Padding="6,3">
      <WrapPanel Orientation="Horizontal" ItemSpacing="0" LineSpacing="4">
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12" Margin="2,0,14,0" />
        <Button Content="View ▾" Margin="0,0,12,0" ToolTip.Tip="Room layers and overlays">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="Background" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowBackground, Mode=OneWay}" Command="{Binding ToggleBackgroundCommand}" />
              <MenuItem Header="Objects" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowObjects, Mode=OneWay}" Command="{Binding ToggleObjectsCommand}" />
              <MenuItem Header="Full-screen objects" ToggleType="CheckBox" StaysOpenOnClick="True"
                        ToolTip.Tip="Draw all 640px-wide object images over the background (or pick one with the Background spinbox)"
                        IsChecked="{Binding ShowFullScreenObjects, Mode=OneWay}" Command="{Binding ToggleFullScreenObjectsCommand}" />
              <MenuItem Header="Unmatched costumes" ToggleType="CheckBox" StaysOpenOnClick="True"
                        ToolTip.Tip="List and draw costumes no object claims (e.g. the player in a cutscene costume)"
                        IsChecked="{Binding ShowUnmatchedCostumes, Mode=OneWay}" Command="{Binding ToggleUnmatchedCostumesCommand}" />
              <MenuItem Header="Hotspots" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowHotspots, Mode=OneWay}" Command="{Binding ToggleHotspotsCommand}" />
              <MenuItem Header="Walkboxes" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowWalkboxes, Mode=OneWay}" Command="{Binding ToggleWalkboxesCommand}" />
              <MenuItem Header="Labels" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowLabels, Mode=OneWay}" Command="{Binding ToggleLabelsCommand}" />
              <MenuItem Header="Room bounds" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowBounds, Mode=OneWay}" Command="{Binding ToggleBoundsCommand}" />
              <MenuItem Header="Z-plane masking" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ZPlaneMasking, Mode=OneWay}" Command="{Binding ToggleZPlaneMaskingCommand}"
                        ToolTip.Tip="Hide the parts of actors behind the room's foreground, as the game does" />
              <MenuItem Header="Draw z-planes" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowZPlanes, Mode=OneWay}" Command="{Binding ToggleZPlanesCommand}"
                        ToolTip.Tip="Tint the room's z-planes (plane 1 red, 2 green, 3 blue, 4 yellow, 5 magenta, 6 cyan)" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <TextBlock Text="Background" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
        <NumericUpDown Value="{Binding BackgroundIndex}" Minimum="0" Maximum="{Binding MaxBackgroundIndex}"
                       IsEnabled="{Binding HasBackgroundChoices}" Increment="1" FormatString="0" Width="96" Margin="0,0,4,0"
                       ToolTip.Tip="The room's own background, then each full-width (640px) object image" />
        <TextBlock Text="{Binding BackgroundLabel}" VerticalAlignment="Center" FontSize="11" MaxWidth="160"
                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,12,0" />
        <TextBlock Text="Palette" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
        <NumericUpDown Value="{Binding PaletteIndex}" Minimum="0" Maximum="{Binding MaxPaletteIndex}"
                       IsEnabled="{Binding HasPaletteChoices}" Increment="1" FormatString="0" Width="96" Margin="0,0,12,0" />
        <ComboBox ItemsSource="{Binding ZPlaneChoices}" SelectedIndex="{Binding ZPlaneShown}" IsVisible="{Binding ShowZPlanes}"
                  MinWidth="110" Margin="0,0,12,0" FontSize="12"
                  ToolTip.Tip="The z-plane to draw: plane 1 red, 2 green, 3 blue, 4 yellow, 5 magenta, 6 cyan" />
        <Button Content="Fit" Click="OnFitClick" Margin="0,0,4,0" ToolTip.Tip="Zoom to fit (F / double-click)" />
        <Button Content="1:1" Click="OnActualClick" ToolTip.Tip="Actual pixels (1)" Margin="0,0,12,0" />
        <ToggleButton Content="Objects" IsChecked="{Binding ShowObjectsPanel}" ToolTip.Tip="Show / hide the Objects panel" />
      </WrapPanel>
    </Border>

    <!-- Hover readout -->
    <Border DockPanel.Dock="Bottom" Padding="8,2">
      <TextBlock Text="{Binding #Canvas.HoverText}" FontSize="11" Classes="mono"
                 Foreground="{StaticResource SubtleTextBrush}" />
    </Border>

    <Grid x:Name="ContentGrid" ColumnDefinitions="*,4,220">
      <c:RoomCanvas x:Name="Canvas"
                    BackgroundImage="{Binding BackgroundImage}"
                    ObjectLayers="{Binding ObjectLayers}"
                    Walkboxes="{Binding Walkboxes}"
                    RoomSize="{Binding RoomSize}"
                    SelectedObject="{Binding SelectedObject, Mode=TwoWay}"
                    ShowBackground="{Binding ShowBackground}"
                    ShowObjects="{Binding ShowObjects}"
                    ShowHotspots="{Binding ShowHotspots}"
                    ShowWalkboxes="{Binding ShowWalkboxes}"
                    ShowLabels="{Binding ShowLabels}"
                    ShowBounds="{Binding ShowBounds}"
                    ShowFullScreenObjects="{Binding ShowFullScreenObjects}"
                    BackgroundObject="{Binding BackgroundObject}"
                    VisibleObjects="{Binding VisibleObjects}"
                    HoldScene="{Binding IsSwitchingRoom}"
                    LiveCostume="{Binding LiveCostume}"
                    ZMasks="{Binding ZMasks}"
                    MaskActors="{Binding ZPlaneMasking}"
                    ZPlaneOverlay="{Binding ZPlaneOverlay}"
                    SelectedObjects="{Binding SelectedObjects}" />

      <GridSplitter x:Name="ObjectsSplitter" Grid.Column="1" ResizeDirection="Columns" />

      <DockPanel x:Name="ObjectsPanel" Grid.Column="2">
        <Border DockPanel.Dock="Top" Classes="panel-header">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <!-- Toggle all: shows a mixed state when only some objects are visible. -->
            <CheckBox IsChecked="{Binding AllObjectsVisible}" MinWidth="0" MinHeight="0" Padding="0"
                      Margin="0,0,6,0" VerticalAlignment="Center" ToolTip.Tip="Show / hide all objects" />
            <TextBlock Grid.Column="1" Text="OBJECTS" VerticalAlignment="Center" />
            <Button Grid.Column="2" Content="Reset" Command="{Binding ResetVisibilityCommand}" Padding="6,0" MinHeight="0"
                    FontSize="11" VerticalAlignment="Center"
                    ToolTip.Tip="Show the objects as the room opens: hidden while their state on entry is 0" />
          </Grid>
        </Border>
        <!-- Multiple: Ctrl / Shift click select several (visibility and Mark for review apply to all);
             the last one clicked is the current one (canvas, Costume viewer). Kept in step in code-behind. -->
        <ListBox x:Name="ObjectList" ItemsSource="{Binding Objects}" SelectionMode="Multiple">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,3" />
            </Style>
            <!-- Objects without an image read as plain entries; ones with an image use the
                 hierarchy's room (LFLF) colour. -->
            <Style Selector="TextBlock.objname">
              <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            </Style>
            <Style Selector="TextBlock.objname.hasImage">
              <Setter Property="Foreground" Value="#E8C07D" />
            </Style>
            <!-- Hotspots with a costumed actor: the hierarchy's AKOS colour. -->
            <Style Selector="TextBlock.objname.hasCostume">
              <Setter Property="Foreground" Value="#E8817D" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:RoomObjectItem">
              <!-- Fixed toggle column so names line up whether or not an object has a toggle. -->
              <Grid ColumnDefinitions="22,*">
                <CheckBox IsChecked="{Binding IsVisible}" IsVisible="{Binding HasToggle}" MinWidth="0" MinHeight="0"
                          Padding="0" VerticalAlignment="Center" Focusable="False" ToolTip.Tip="Visible (Space)" />
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <TextBlock Text="⚑" FontSize="11" Foreground="#E06C75" IsVisible="{Binding IsMarked}"
                               ToolTip.Tip="{Binding MarkText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" FontSize="12" Classes="objname" Classes.hasImage="{Binding HasImage}" Classes.hasCostume="{Binding HasCostume}" />
                  </StackPanel>
                  <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
