<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMUCS.Desktop.ViewModels"
             xmlns:c="using:MMUCS.Desktop.Controls"
             x:Class="MMUCS.Desktop.Views.RoomView"
             x:DataType="vm:RoomViewModel">
  <DockPanel>
    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="panel-header" Padding="6,3">
      <WrapPanel Orientation="Horizontal" ItemSpacing="0" LineSpacing="4">
        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="12" Margin="2,0,14,0" />
        <Button Content="View ▾" Margin="0,0,12,0" ToolTip.Tip="Room layers and overlays">
          <Button.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedLeft">
              <MenuItem Header="Background" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowBackground, Mode=OneWay}" Command="{Binding ToggleBackgroundCommand}" />
              <MenuItem Header="Objects" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowObjects, Mode=OneWay}" Command="{Binding ToggleObjectsCommand}" />
              <MenuItem Header="Full-screen objects" ToggleType="CheckBox" StaysOpenOnClick="True"
                        ToolTip.Tip="Draw all 640px-wide object images over the background (or pick one with the Background spinbox)"
                        IsChecked="{Binding ShowFullScreenObjects, Mode=OneWay}" Command="{Binding ToggleFullScreenObjectsCommand}" />
              <MenuItem Header="Hotspots" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowHotspots, Mode=OneWay}" Command="{Binding ToggleHotspotsCommand}" />
              <MenuItem Header="Walkboxes" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowWalkboxes, Mode=OneWay}" Command="{Binding ToggleWalkboxesCommand}" />
              <MenuItem Header="Labels" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowLabels, Mode=OneWay}" Command="{Binding ToggleLabelsCommand}" />
              <MenuItem Header="Room bounds" ToggleType="CheckBox" StaysOpenOnClick="True"
                        IsChecked="{Binding ShowBounds, Mode=OneWay}" Command="{Binding ToggleBoundsCommand}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
        <TextBlock Text="Background" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
        <NumericUpDown Value="{Binding BackgroundIndex}" Minimum="0" Maximum="{Binding MaxBackgroundIndex}"
                       IsEnabled="{Binding HasBackgroundChoices}" Increment="1" FormatString="0" Width="96" Margin="0,0,4,0"
                       ToolTip.Tip="The room's own background, then each full-width (640px) object image" />
        <TextBlock Text="{Binding BackgroundLabel}" VerticalAlignment="Center" FontSize="11" MaxWidth="160"
                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,12,0" />
        <TextBlock Text="Palette" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
        <NumericUpDown Value="{Binding PaletteIndex}" Minimum="0" Maximum="{Binding MaxPaletteIndex}"
                       IsEnabled="{Binding HasPaletteChoices}" Increment="1" FormatString="0" Width="96" Margin="0,0,12,0" />
        <Button Content="Fit" Click="OnFitClick" Margin="0,0,4,0" ToolTip.Tip="Zoom to fit (F / double-click)" />
        <Button Content="1:1" Click="OnActualClick" ToolTip.Tip="Actual pixels (1)" />
      </WrapPanel>
    </Border>

    <!-- Hover readout -->
    <Border DockPanel.Dock="Bottom" Padding="8,2">
      <TextBlock Text="{Binding #Canvas.HoverText}" FontSize="11" Classes="mono"
                 Foreground="{StaticResource SubtleTextBrush}" />
    </Border>

    <Grid ColumnDefinitions="*,4,220">
      <c:RoomCanvas x:Name="Canvas"
                    BackgroundImage="{Binding BackgroundImage}"
                    ObjectLayers="{Binding ObjectLayers}"
                    Walkboxes="{Binding Walkboxes}"
                    RoomSize="{Binding RoomSize}"
                    SelectedObject="{Binding SelectedObject, Mode=TwoWay}"
                    ShowBackground="{Binding ShowBackground}"
                    ShowObjects="{Binding ShowObjects}"
                    ShowHotspots="{Binding ShowHotspots}"
                    ShowWalkboxes="{Binding ShowWalkboxes}"
                    ShowLabels="{Binding ShowLabels}"
                    ShowBounds="{Binding ShowBounds}"
                    ShowFullScreenObjects="{Binding ShowFullScreenObjects}"
                    BackgroundObject="{Binding BackgroundObject}"
                    HiddenObjects="{Binding HiddenObjects}" />

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <DockPanel Grid.Column="2">
        <Border DockPanel.Dock="Top" Classes="panel-header">
          <Grid ColumnDefinitions="Auto,*">
            <!-- Toggle all: shows a mixed state when only some objects are visible. -->
            <CheckBox IsChecked="{Binding AllObjectsVisible}" MinWidth="0" MinHeight="0" Padding="0"
                      Margin="0,0,6,0" VerticalAlignment="Center" ToolTip.Tip="Show / hide all objects" />
            <TextBlock Grid.Column="1" Text="OBJECTS" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <ListBox ItemsSource="{Binding Objects}" SelectedItem="{Binding SelectedObjectItem, Mode=TwoWay}">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="8,3" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:RoomObjectItem">
              <Grid ColumnDefinitions="Auto,*">
                <CheckBox IsChecked="{Binding IsVisible}" MinWidth="0" MinHeight="0" Padding="0"
                          Margin="0,0,6,0" VerticalAlignment="Center" ToolTip.Tip="Visible" />
                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Name}" FontSize="12" />
                  <TextBlock Text="{Binding Summary}" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</UserControl>
