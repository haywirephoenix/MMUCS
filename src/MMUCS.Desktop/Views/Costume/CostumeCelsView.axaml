<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMUCS.Desktop.ViewModels"
             x:Class="MMUCS.Desktop.Views.Costume.CostumeCelsView"
             x:DataType="vm:AkosViewModel">
  <ListBox ItemsSource="{Binding Cels}" SelectedItem="{Binding SelectedCel, Mode=TwoWay}">
    <ListBox.Styles>
      <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="MinHeight" Value="0" />
      </Style>
    </ListBox.Styles>
    <ListBox.ItemTemplate>
      <DataTemplate DataType="vm:CelItem">
        <TextBlock Text="{Binding}" FontSize="12" Classes="mono" />
      </DataTemplate>
    </ListBox.ItemTemplate>
  </ListBox>
</UserControl>
