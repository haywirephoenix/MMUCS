<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMUCS.Desktop.ViewModels"
             xmlns:c="using:MMUCS.Desktop.Controls"
             x:Class="MMUCS.Desktop.Views.Costume.CostumePreviewView"
             x:DataType="vm:AkosViewModel">
    <!-- The shared preview panel (Controls/ViewerPreview.cs): title, Options, Fit / 1:1, info, canvas. -->
    <c:ViewerPreview Title="{Binding Title}" Info="{Binding Info}">
        <c:ViewerPreview.Tools>
            <Button Content="Options ▾" Margin="0,0,8,0">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedLeft">
                        <StackPanel Width="160" Spacing="8">
                            <ComboBox ItemsSource="{Binding Modes}"
                                      SelectedItem="{Binding Mode}"
                                      HorizontalAlignment="Stretch"
                                      ToolTip.Tip="Shader: GPU palette resolve (SkSL) · Index: encoded data · Raw: CPU resolve" />
                            <CheckBox Content="Alpha" IsChecked="{Binding AlphaEnabled}" />
                            <CheckBox Content="Shadow" IsChecked="{Binding ShadowColorEnabled}" />
                            <CheckBox Content="Linear" IsChecked="{Binding LinearFilter}" />
                            <CheckBox Content="CelInfo" IsChecked="{Binding CelInfoEnabled}" />
                            <TextBlock Text="Shadow Amount" VerticalAlignment="Center" FontSize="12" Margin="0,0,4,0" />
                            <Slider Value="{Binding ShadowAmount}" Minimum="0" Maximum="1" Width="90" Margin="0,0,8,0"
                                    VerticalAlignment="Center" ToolTip.Tip="Shadow amount" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </c:ViewerPreview.Tools>

        <c:CelCanvas x:Name="Canvas"
                     DataImage="{Binding DataImage}"
                     RawImage="{Binding RawImage}"
                     PaletteImage="{Binding PaletteImage}"
                     Mode="{Binding Mode}"
                     AlphaEnabled="{Binding AlphaEnabled}"
                     ShadowColorEnabled="{Binding ShadowColorEnabled}"
                     ShadowAmount="{Binding ShadowAmount}"
                     LinearFilter="{Binding LinearFilter}" />

        <c:ViewerPreview.Overlay>
            <ScrollViewer x:Name="InfoScrollViewer"
                          IsVisible="{Binding CelInfoEnabled}"
                          VerticalAlignment="Bottom"
                          HorizontalAlignment="Left"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="8"
                          Background="{DynamicResource OverlayBackgroundBrush}">
                <TextBlock Text="{Binding CelInfo}"
                           Classes="mono"
                           FontSize="11"
                           Margin="8,4"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleTextBrush}" />
            </ScrollViewer>
        </c:ViewerPreview.Overlay>
    </c:ViewerPreview>
</UserControl>
