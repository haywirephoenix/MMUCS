<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MMUCS.Desktop.ViewModels"
             xmlns:c="using:MMUCS.Desktop.Controls"
             x:Class="MMUCS.Desktop.Views.Costume.CostumePreviewView"
             x:DataType="vm:AkosViewModel">
    <Grid>
        <c:CelCanvas x:Name="Canvas"
                     DataImage="{Binding DataImage}"
                     RawImage="{Binding RawImage}"
                     PaletteImage="{Binding PaletteImage}"
                     Mode="{Binding Mode}"
                     AlphaEnabled="{Binding AlphaEnabled}"
                     ShadowColorEnabled="{Binding ShadowColorEnabled}"
                     ShadowAmount="{Binding ShadowAmount}"
                     LinearFilter="{Binding LinearFilter}" />
  
        <ScrollViewer x:Name="InfoScrollViewer"
                      VerticalAlignment="Bottom"
                      HorizontalAlignment="Left"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Margin="8"
                      Background="#80000000">
            <TextBlock Text="{Binding CelInfo}"
                       Classes="mono"
                       FontSize="11"
                       Margin="8,4"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource SubtleTextBrush}" />
        </ScrollViewer>
    </Grid>
</UserControl>