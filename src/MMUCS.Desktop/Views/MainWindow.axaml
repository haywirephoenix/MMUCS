<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MMUCS.Desktop.ViewModels"
        xmlns:dock="using:Dock.Avalonia.Controls"
        x:Class="MMUCS.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="/Assets/mmucs.ico"
        Width="1440" Height="900" MinWidth="900" MinHeight="560"
        DragDrop.AllowDrop="True">

  <DockPanel>
    <!-- Shows the NativeMenu (built in code-behind) inside the window on Windows/Linux;
         on macOS the menu goes to the system menu bar and this hides itself. -->
    <NativeMenuBar DockPanel.Dock="Top" />

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelHeaderBrush}" Padding="8,3">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Status}" FontSize="12" TextTrimming="CharacterEllipsis" />
        <ProgressBar Grid.Column="1" IsIndeterminate="True" Width="120" Height="4"
                     IsVisible="{Binding IsLoading}" />
      </Grid>
    </Border>

    <!-- Panels: Blocks | Room / Costume / Script | Metadata over Hex. Drag tabs to rearrange
         or tear them off into their own windows. -->
    <dock:DockControl Layout="{Binding Layout}" Margin="2,0,2,2" />
  </DockPanel>
</Window>
