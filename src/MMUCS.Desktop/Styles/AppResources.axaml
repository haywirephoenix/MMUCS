<!-- App-wide resources. App resources take precedence over the Dock theme's, so keys here (and in
     Colors.axaml) that match Dock's replace its defaults. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <!-- Every colour, by name. -->
    <ResourceInclude Source="/Styles/Colors.axaml" />
    <!-- Drop targets as invisible edge zones instead of icons. -->
    <ResourceInclude Source="/Styles/DockTargets.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

  <!-- Dock layout overrides (colours for these are in Colors.axaml). -->
  <Thickness x:Key="DockDocumentContentBorderThickness">0</Thickness>
  <x:Boolean x:Key="DockDocumentTabStripSeparatorVisible">False</x:Boolean>
</ResourceDictionary>
