<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MMUCS.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#99FFFFFF" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />

    <Style Selector="Border.panel-header">
      <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.panel-header > TextBlock, Border.panel-header > Grid > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style Selector="StackPanel.toolbar">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="6,4" />
    </Style>
  </Application.Styles>
</Application>
