<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockTheme="using:Dock.Avalonia.Themes.Fluent"
             xmlns:local="using:MMUCS.Desktop"
             xmlns:views="using:MMUCS.Desktop.Views"
             x:Class="MMUCS.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/AppResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!-- Panel content for each dockable. App-level so floating (host) windows resolve them too. -->
  <Application.DataTemplates>
    <!-- One long-lived Costume viewer: it hosts its own docking area (see CostumeViewTemplate). -->
    <views:CostumeViewTemplate />
    <!-- Every other panel (see ViewLocator). -->
    <local:ViewLocator />
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <dockTheme:DockFluentTheme />
    <!-- After the themes, so these override them. -->
    <StyleInclude Source="/Styles/ControlStyles.axaml" />
  </Application.Styles>
</Application>
