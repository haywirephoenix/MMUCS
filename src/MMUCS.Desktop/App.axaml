<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dockTheme="using:Dock.Avalonia.Themes.Fluent"
             xmlns:dockCtl="using:Dock.Avalonia.Controls"
             xmlns:dockCore="using:Dock.Model.Core"
             xmlns:dvm="using:MMUCS.Desktop.ViewModels.Docking"
             xmlns:views="using:MMUCS.Desktop.Views"
             xmlns:panels="using:MMUCS.Desktop.Views.Panels"
             x:Class="MMUCS.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
    <SolidColorBrush x:Key="PanelHeaderBrush" Color="#000000" />
    <SolidColorBrush x:Key="ListBackgroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#99FFFFFF" />

    <!-- Dock tabs: neutral greys instead of the theme's blue for hovered/active tabs. App resources
         take precedence over the Dock theme's. (Drop targets and splitters keep the blue accent.) -->
    <SolidColorBrush x:Key="DockTabHoverBackgroundBrush" Color="#3A3A3F" />
    <SolidColorBrush x:Key="DockTabActiveBackgroundBrush" Color="#4A4A50" />
    <SolidColorBrush x:Key="DockTabActiveIndicatorBrush" Color="#707078" />
    <SolidColorBrush x:Key="DockTabSelectedForegroundBrush" Color="#F0F0F0" />
    <SolidColorBrush x:Key="DockTabCloseHoverBackgroundBrush" Color="#5A5A62" />

    <!-- No outlines around panels: the only lines are the splitters, where panels can be resized. -->
    <SolidColorBrush x:Key="DockBorderSubtleBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DockBorderStrongBrush" Color="Transparent" />
    <SolidColorBrush x:Key="DockDocumentContentBorderBrush" Color="Transparent" />
    <Thickness x:Key="DockDocumentContentBorderThickness">0</Thickness>
    <SolidColorBrush x:Key="DockSplitterIdleBrush" Color="#2E2E33" />
    <SolidColorBrush x:Key="DockSeparatorBrush" Color="Transparent" />
    <x:Boolean x:Key="DockDocumentTabStripSeparatorVisible">False</x:Boolean>
  </Application.Resources>

  <!-- Panel content for each dockable. App-level so floating (host) windows resolve them too. -->
  <Application.DataTemplates>
    <DataTemplate DataType="dvm:BlocksTool">
      <panels:BlockTreeView DataContext="{Binding Main}" />
    </DataTemplate>
    <DataTemplate DataType="dvm:MetadataTool">
      <panels:MetadataView DataContext="{Binding Main}" />
    </DataTemplate>
    <DataTemplate DataType="dvm:HexTool">
      <panels:HexPanelView DataContext="{Binding Main}" />
    </DataTemplate>
    <DataTemplate DataType="dvm:RoomDocument">
      <views:RoomView DataContext="{Binding Main.Room}" />
    </DataTemplate>
    <DataTemplate DataType="dvm:CostumeDocument">
      <views:AkosView DataContext="{Binding Main.Costume}" />
    </DataTemplate>
    <DataTemplate DataType="dvm:ScriptDocument">
      <panels:ScriptView DataContext="{Binding Main.Script}" />
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <dockTheme:DockFluentTheme />
    
    <Style Selector="NumericUpDown">
      <Setter Property="MaxHeight" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="MaxHeight" Value="24" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Slider">
      <Setter Property="MaxHeight" Value="24" />
    </Style>
    <Style Selector="Slider /template/ Track">
      <Setter Property="Margin" Value="0,-10,0,0" />
    </Style>

    <!-- Splitters (the theme leaves them transparent) show as thin lines: the only lines between
         panels, marking where they can be resized. -->
    <Style Selector="ProportionalStackPanelSplitter">
      <Setter Property="Background" Value="{DynamicResource DockSplitterIdleBrush}" />
    </Style>
    <Style Selector="ProportionalStackPanelSplitter:pointerover">
      <Setter Property="Background" Value="{DynamicResource DockSplitterHoverBrush}" />
    </Style>

    <!-- A tab whose panel got new content while hidden shows a white dot (Dock's "modified"
         indicator, a * by default); bringing the tab forward clears it. -->
    <Style Selector="dockCtl|DocumentControl">
      <Setter Property="ModifiedTemplate">
        <DataTemplate DataType="dockCore:IDockable">
          <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center" Margin="2,0,4,0" />
        </DataTemplate>
      </Setter>
    </Style>
    <Style Selector="dockCtl|ToolControl">
      <Setter Property="ModifiedTemplate">
        <DataTemplate DataType="dockCore:IDockable">
          <Ellipse Width="6" Height="6" Fill="White" VerticalAlignment="Center" Margin="2,0,4,0" />
        </DataTemplate>
      </Setter>
    </Style>
    
    <!-- Blue text selection highlight for both dark and light modes -->
    <Style Selector="TextBox">
      <Setter Property="SelectionBrush" Value="#2563EB" />
      <Setter Property="SelectionForegroundBrush" Value="White" />
    </Style>
    <Style Selector="SelectableTextBlock">
      <Setter Property="SelectionBrush" Value="#2563EB" />
      <Setter Property="SelectionForegroundBrush" Value="White" />
    </Style>

    <!-- Drop-target overlay: colour-inverted copies of Dock's icons (dark tiles with a blue fill,
         less glaring on the dark theme). Regenerate: magick in.png -channel RGB -negate +channel out.png -->
    <Style Selector="DockTarget /template/ Image#PART_TopSelector">
      <Setter Property="Source" Value="/Assets/Dock/DockAnchorableTop.png" />
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_BottomSelector">
      <Setter Property="Source" Value="/Assets/Dock/DockAnchorableBottom.png" />
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_LeftSelector">
      <Setter Property="Source" Value="/Assets/Dock/DockAnchorableLeft.png" />
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_RightSelector">
      <Setter Property="Source" Value="/Assets/Dock/DockAnchorableRight.png" />
    </Style>
    <Style Selector="DockTarget /template/ Image#PART_CenterSelector">
      <Setter Property="Source" Value="/Assets/Dock/DockDocumentInside.png" />
    </Style>
    <Style Selector="GlobalDockTarget /template/ Image#PART_TopSelector">
      <Setter Property="Source" Value="/Assets/Dock/DockAnchorableTop.png" />
    </Style>
    <Style Selector="GlobalDockTarget /template/ Image#PART_BottomSelector">
      <Setter Property="Source" Value="/Assets/Dock/DockAnchorableBottom.png" />
    </Style>
    <Style Selector="GlobalDockTarget /template/ Image#PART_LeftSelector">
      <Setter Property="Source" Value="/Assets/Dock/DockAnchorableLeft.png" />
    </Style>
    <Style Selector="GlobalDockTarget /template/ Image#PART_RightSelector">
      <Setter Property="Source" Value="/Assets/Dock/DockAnchorableRight.png" />
    </Style>
    <Style Selector="GlobalDockTarget /template/ Image#PART_CenterSelector">
      <Setter Property="Source" Value="/Assets/Dock/DockDocumentInside.png" />
    </Style>

    <!-- Floating panel windows use the app icon. -->
    <Style Selector="dockCtl|HostWindow">
      <Setter Property="Icon" Value="/Assets/mmucs.ico" />
    </Style>

    <Style Selector="Border.panel-header">
      <Setter Property="Background" Value="{StaticResource PanelHeaderBrush}" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.panel-header > TextBlock, Border.panel-header > Grid > TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
    </Style>
    <!-- One list background everywhere, so no list shows Fluent's default grey. -->
    <Style Selector="ListBox">
      <Setter Property="Background" Value="{StaticResource ListBackgroundBrush}" />
    </Style>

    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    </Style>
    <Style Selector="StackPanel.toolbar">
      <Setter Property="Orientation" Value="Horizontal" />
      <Setter Property="Spacing" Value="6" />
      <Setter Property="Margin" Value="6,4" />
    </Style>
  </Application.Styles>
</Application>
