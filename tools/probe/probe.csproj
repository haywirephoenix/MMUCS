<Project Sdk="Microsoft.NET.Sdk">
  <!-- A command-line companion to MMUCS: exports and debug renders from MMUCS.Core, without the app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>MMUCS.Probe</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MMUCS.Core\MMUCS.Core.csproj" />
  </ItemGroup>
</Project>
