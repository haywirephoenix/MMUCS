<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Timing and memory checks against the real game, run by hand in Release (dotnet test doesn't run
    them). Program.cs has the command line and the list of benchmarks.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real Skia rendering without a screen: views, bindings and draw operations run as in the app. -->
    <PackageReference Include="Avalonia.Headless" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MMUCS.Desktop\MMUCS.Desktop.csproj" />
    <ProjectReference Include="..\..\src\MMUCS.Media.OpenAL\MMUCS.Media.OpenAL.csproj" />
  </ItemGroup>

</Project>
